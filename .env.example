# Copiez ce fichier en .env à la racine du projet avant `docker compose up -d`.
# Ce fichier est lu par docker-compose.yml (racine du projet) — distinct de
# backend/.env.example qui sert au développement local sans Docker.

# Nom de domaine public de la mairie, déjà pointé (DNS A) vers ce serveur.
# Caddy obtient et renouvelle automatiquement son certificat HTTPS pour ce domaine.
DOMAIN=etat-civil.porto-novo.bj

# E-mail utilisé par Let's Encrypt pour les notifications (expiration, etc.)
CADDY_ADMIN_EMAIL=contact@porto-novo.bj

# URL publique du frontend (avec https://) — sert à construire les liens envoyés
# par e-mail (réinitialisation de mot de passe) et les URLs de retour CinetPay.
FRONTEND_URL=https://etat-civil.porto-novo.bj

# Secret de signature des jetons JWT — générez une valeur unique et longue :
# openssl rand -hex 32
JWT_SECRET=

# Envoi d'e-mails (mot de passe oublié). Laissez vide pour tester d'abord sans
# SMTP réel — les liens de réinitialisation apparaîtront dans les logs du
# conteneur backend (`docker compose logs -f backend`).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mairie de Porto-Novo <no-reply@porto-novo.bj>"

# Paiement CinetPay (obtenu sur cinetpay.com après inscription du marchand
# "Mairie de Porto-Novo"). Laissez vide tant que non signé : la soumission de
# demande fonctionne quand même, seul le paiement en ligne reste indisponible.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# Interconnexion plateforme nationale e-services Bénin (Phase 4) — n'existe pas
# encore à ce jour. Laissez vide : les comptes citoyens restent simplement
# marqués "NON_VERIFIE", aucune inscription n'est bloquée.
ESERVICES_BENIN_API_URL=
ESERVICES_BENIN_API_KEY=
NIP_VERIFICATION_STRICTE=false

# Identité affichée sur le portail
MAIRIE_NOM="Mairie de Porto-Novo"
MAIRIE_ADRESSE="Porto-Novo, Bénin"
MAIRIE_TELEPHONE=""
MAIRIE_EMAIL="etatcivil@porto-novo.bj"
