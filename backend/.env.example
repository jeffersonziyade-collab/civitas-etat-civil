PORT=4000
NODE_ENV=development

# Base de données
MONGODB_URI=mongodb://localhost:27017/etat_civil

# Authentification agents (Back-Office)
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h

# URL publique du frontend — utilisée pour construire les liens envoyés par e-mail
# (réinitialisation de mot de passe). Ex: https://etat-civil.porto-novo.bj
FRONTEND_URL=http://localhost:5173

# Envoi d'e-mails (mot de passe oublié). Si SMTP_HOST est vide, les e-mails sont
# simplement affichés dans les logs du serveur — pratique pour tester en local
# sans compte SMTP réel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mairie de Porto-Novo <no-reply@porto-novo.bj>"

# Interconnexion plateforme e-services Bénin (Phase 4)
ESERVICES_BENIN_API_URL=
ESERVICES_BENIN_API_KEY=
# Bloque l'inscription citoyenne si le NIP ne correspond pas au nom/prénom déclarés
# (nécessite ESERVICES_BENIN_API_URL/API_KEY configurées). Laisser à false tant que
# l'interconnexion réelle n'est pas fiabilisée : sinon les comptes restent NON_VERIFIE.
NIP_VERIFICATION_STRICTE=false

# Paiement CinetPay (obtenir ces identifiants sur cinetpay.com après inscription du marchand "Mairie de Porto-Novo")
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# URL publique du backend (nécessaire pour que CinetPay puisse notifier le paiement) — ex: https://etat-civil.porto-novo.bj/api
CINETPAY_NOTIFY_URL=http://localhost:4000/api/paiement/webhook
# URL de retour citoyen après paiement — ex: https://etat-civil.porto-novo.bj/suivi
CINETPAY_RETURN_URL=http://localhost:5173/suivi

# Autres prestataires (branchement futur, non implémenté)
MTN_MOMO_API_KEY=
MOOV_MONEY_API_KEY=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# Identité de la mairie (affichée sur le portail)
MAIRIE_NOM="Mairie de Porto-Novo"
MAIRIE_ADRESSE="Porto-Novo, Bénin"
MAIRIE_TELEPHONE=""
MAIRIE_EMAIL="etatcivil@porto-novo.bj"

# Upload
UPLOAD_DIR=uploads
